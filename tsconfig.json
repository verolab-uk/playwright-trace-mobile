{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "paths": {
      "@injected/*": ["./packages/injected/src/*"],
      "@isomorphic/*": ["./packages/isomorphic/*"],
      "@protocol/*": ["./packages/protocol/src/*"],
      "@recorder/*": ["./packages/recorder/src/*"],
      "@testIsomorphic/*": ["./packages/playwright/src/isomorphic/*"],
      "@web/*": ["./packages/web/src/*"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true
  },
  "include": ["packages/trace-viewer/src", "vite.config.ts", "playwright.config.ts", "tests"]
}
